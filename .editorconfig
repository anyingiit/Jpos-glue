# Source: EditorConfig (official specification) — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{java,gradle}]
indent_style = space
indent_size = 4

[*.properties]
indent_style = space
indent_size = 4

[gradlew.bat]
end_of_line = crlf
